filters:
  and:
    - file.inFolder("Bookmarks")
    - file.ext == "md"
properties:
  note.url:
    displayName: URL
  note.category:
    displayName: Catégorie
  note.status:
    displayName: Statut
views:
  - type: table
    name: Par catégorie
    groupBy:
      property: category
      direction: ASC
    order:
      - file.name
      - url
      - tags
      - description
    sort:
      - property: file.name
        direction: ASC
  - type: table
    name: À lire
    filters:
      and:
        - note.status == "to-read"
    order:
      - file.name
      - category
      - url
      - date
  - type: table
    name: Récents
    order:
      - file.name
      - category
      - date
    sort:
      - property: date
        direction: DESC
